NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
DEMO_AUTH_SECRET=replace-with-a-random-value

# Server-only admin login slots. Use DEMO_ADMIN_USERNAME_N for bare usernames
# or DEMO_ADMIN_EMAIL_N for email identifiers. Configure up to three slots.
DEMO_ADMIN_EMAIL_1=admin@gmail.com
DEMO_ADMIN_PASSWORD_1=replace-with-a-strong-password
DEMO_ADMIN_EMAIL_2=ops@example.com
DEMO_ADMIN_PASSWORD_2=replace-with-a-strong-password
DEMO_ADMIN_EMAIL_3=reviewer@example.com
DEMO_ADMIN_PASSWORD_3=replace-with-a-strong-password

# Legacy slot-1 aliases remain supported when no numbered slots are configured.
# DEMO_ADMIN_EMAIL=admin@gmail.com
# DEMO_ADMIN_PASSWORD=admin1234
