# copy to .env, never commit .env
# The API boots with every one of these unset; each missing key just disables
# one feature. GET /readiness reports what is actually wired.

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
IFM_API_KEY=
IFM_BASE_URL=
IFM_MODEL=
QUERIT_API_KEY=
# Shared rate limit per process; failed requests retry at most twice.
QUERIT_INTERVAL_SECONDS=1
# Optional path to a preinstalled sentence-transformers model. No request-time downloads.
DISCOVERY_EMBEDDING_MODEL=
# Optional trained sale-basis calibration JSON; its benchmark_version must match.
VALUATION_CALIBRATION_FILE=
GOOGLE_PLACES_API_KEY=

# Storage. LEAVE EMPTY to run on the in-memory store, which needs nothing and
# is what the tests use. Set it to switch app/deps.py over to MongoStore:
#   local:  mongodb://localhost:27017   (docker compose up -d mongo)
#   atlas:  the M0 free tier plus $50 student credit, https://mlh.link/mongodb
#           allowlist 0.0.0.0/0 for the hackathon so the Vultr box can connect
# After pointing at a database, run: uv run python migrate.py up
# Quote the Atlas value. The SRV string contains & between query parameters,
# which ends the statement in any shell that sources this file.
MONGODB_URI=
MONGODB_DB=jb

# Engine knobs (see apps/api/README.md): SEED loads seeds/companies.json,
# BOTS runs the demo bot traders, TICK_S is the scheduler period,
# STATE_FILE snapshots the in-memory store so a demo survives a restart.
SEED=1
BOTS=1
TICK_S=1.0
STATE_FILE=
# Set to 1 to use any configured live source after the seeded results stream.
# Grok can search the web directly; Places and Querit continue independently.
DISCOVERY_LIVE=0

# Demo auth is the only implemented path: X-Demo-User: <name or email>.
# An email makes the session claimable by a real login later (app/identity.py).
DEMO_AUTH=1
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

ENV=dev
CORS_ORIGINS=http://localhost:3000

# Administrator console. Generate a secret token; do not use NEXT_PUBLIC_.
# /surveillance and /security fail closed until this is configured.
ADMIN_API_TOKEN=
# Independently review new findings with configured Grok/K2 providers.
SECURITY_AUTO_REVIEW=1
# Shared secret between the API and apps/imessage; authenticates bridge traffic.
BRIDGE_API_TOKEN=
# The real assigned Photon line, displayed in the user workspace.
IMESSAGE_NUMBER=
