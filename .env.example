# copy to .env, never commit .env
# The API boots with every one of these unset; each missing key just disables
# one feature. GET /readiness reports what is actually wired.

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
IFM_API_KEY=
IFM_BASE_URL=
IFM_MODEL=
QUERIT_API_KEY=
GOOGLE_PLACES_API_KEY=

# Atlas M0 free tier plus $50 student credit: https://mlh.link/mongodb
# Allowlist 0.0.0.0/0 for the hackathon so the Vultr box can connect.
# Empty means the local container from docker-compose.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=jb

# Demo auth is the only implemented path: X-Demo-User: <name or email>.
# An email makes the session claimable by a real login later (app/identity.py).
DEMO_AUTH=1
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

ENV=dev
CORS_ORIGINS=http://localhost:3000
