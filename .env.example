# Copy to .env at the repo root. Never commit .env.
# The API boots with every one of these unset; each missing key just disables
# one feature. Check GET /readiness to see what is actually wired.

ENV=dev
CORS_ORIGINS=http://localhost:3000

# --- database -------------------------------------------------------------
# OWNER: Vir. Local default works with `docker compose up mongo`.
# Atlas M0 free tier + $50 student credit: https://mlh.link/mongodb
# Allowlist 0.0.0.0/0 for the hackathon so the Vultr box can connect.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=jb

# --- auth -----------------------------------------------------------------
# Demo auth is the only implemented path: send `X-Demo-User: <name or email>`.
# An email makes the session claimable by a real login later (app/identity.py).
DEMO_AUTH=true
# Auth0 is NOT wired yet (docs/DECISIONS.md 002). Vars reserved so the env
# surface does not change when it lands. https://mlh.link/auth0-signup
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# --- models ---------------------------------------------------------------
# OWNER: ask at the SpaceXAI table for hackathon credits; else a personal key
# with a $10 cap. Whole event costs under $5 at grok-4.6 prices.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# OWNER: whoever attends the 9 PM IFM workshop. Needed for the IFM prize.
IFM_API_KEY=
IFM_BASE_URL=
IFM_MODEL=

# --- search and business data ---------------------------------------------
# OWNER: anyone. Free tier is 1,000 searches/month, no card.
# https://www.querit.ai/en/docs/overview/quickstart
QUERIT_API_KEY=

# OWNER: Vir. Requires a billing account with a card attached even for the
# free tier, so start this early. Set a $5 budget cap.
GOOGLE_PLACES_API_KEY=
