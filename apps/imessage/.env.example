# Photon Spectrum project credentials (app.photon.codes -> project -> Settings)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# JB API. Leave unset to run the bridge against a canned script (demo before the agent exists).
# JB_API_URL=https://api.jb.example

# Optional
# TERMINAL_UI=1      # also open Spectrum's local terminal chat UI (dev only, no phone line needed)
